TOKEN=YOUR_BOT_TOKEN
ADMIN_GROUP_ID=GROUP_ID_WITH_MINUS
ADMIN_IDS=[]

CONFIG_PATH=mtprotoproxy/config.py
CONTAINER_NAME=mtproto-proxy

DOMAIN=ya.ru
PORT=443
DOCKER_PORT=4443
SERVER=YOUR_SERVER_IP_OR_DOMAIN

DB_PATH=mtproto_bot.db

ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
FLASK_PORT=5000

XUI_BASE_URL=https://mysite.ru
XUI_USERNAME=admin
XUI_PASSWORD=YOUR_X_UI_PASSWORD
XUI_SUB_URL_BASE=https://mysite.ru/sub/

# Optional: API token for 3x-ui 3.x+.  If set, XUI_USERNAME / XUI_PASSWORD are ignored.
# Generate in 3x-ui panel → Settings → API Keys.
# XUI_API_TOKEN=your_api_token_here

XRAY_INBOUND_ID=1

# Trojan — 3x-ui inbound ID (create an inbound with protocol "trojan" on the panel first)
# TROJAN_INBOUND_ID=2
# TROJAN_ENABLED=false

# Hysteria2 — 3x-ui inbound ID (create an inbound with protocol "hysteria2" on the panel first)
# HYSTERIA2_INBOUND_ID=3
# HYSTERIA2_ENABLED=false
